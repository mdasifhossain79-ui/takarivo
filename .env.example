# Takarivo — Environment Variables Template
# Copy this file to .env and fill in your Supabase credentials:
# cp .env.example .env

# Your Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anon (public) Key (safe for frontend use)
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (secret, server-side only for netlify functions if needed)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
