<?xml version="1.0" encoding="UTF-8"?>
<!-- Takarivo — sitemap.xml
     Replace https://your-domain.example with your real deployed domain.
     Only public, indexable pages are listed — authenticated app pages
     (Dashboard, Accounts, Transactions, etc.) are intentionally
     excluded, matching robots.txt. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

    <url>
        <loc>https://your-domain.example/</loc>
        <changefreq>monthly</changefreq>
        <priority>1.0</priority>
    </url>

    <url>
        <loc>https://your-domain.example/pages/login.html</loc>
        <changefreq>yearly</changefreq>
        <priority>0.3</priority>
    </url>

    <url>
        <loc>https://your-domain.example/pages/register.html</loc>
        <changefreq>yearly</changefreq>
        <priority>0.5</priority>
    </url>

</urlset>
